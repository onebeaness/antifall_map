# frontend/.env.local 로 복사해서 사용
# 백엔드(FastAPI) 주소 — 배포 시 실제 백엔드 URL로 교체
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 배경지도 — 티맵 JavaScript API용 appKey (openapi.sk.com)
# ⚠️ 백엔드의 TMAP_APP_KEY와 **다른 키**를 쓸 것. 이 값은 브라우저 번들에
#    노출되므로, 백엔드 키를 넣으면 제3자가 경로 API 할당량을 소진시킬 수 있다.
#    openapi.sk.com에서 앱을 하나 더 만들어 JS 지도용 키를 발급하고
#    해당 앱에 서비스 도메인(localhost:3000, 배포 주소)을 등록한다.
# 없으면 지도 자리에 설정 안내가 표시된다. 빌드 시점 주입이라 변경 시 재배포 필요.
NEXT_PUBLIC_TMAP_APP_KEY=
