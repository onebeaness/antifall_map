# frontend/.env.local 로 복사해서 사용
# 백엔드(FastAPI) 주소 — 배포 시 실제 백엔드 URL로 교체
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 배경지도 — 티맵 JavaScript API용 appKey (openapi.sk.com)
# 보통은 **비워둔다**. 비워두면 백엔드 /api/config/map 에서 런타임에 받아오므로
# (백엔드 TMAP_JS_APP_KEY → 없으면 TMAP_APP_KEY) 프론트 재배포 없이 키를 바꿀 수 있다.
# 여기에 값을 넣으면 정적 산출물에 그대로 구워져 변경할 때마다 재배포가 필요하다.
NEXT_PUBLIC_TMAP_APP_KEY=
