# frontend/.env.local 로 복사해서 사용
# 백엔드(FastAPI) 주소 — 배포 시 실제 백엔드 URL로 교체
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 선택 — 카카오맵 JavaScript 키 (developers.kakao.com → 앱 → 플랫폼 Web에
# http://localhost:3000 과 배포 도메인 등록). 있으면 배경지도가 카카오맵으로
# 바뀌고, 없거나 로드 실패 시 OSM(Leaflet)으로 자동 폴백된다.
# 빌드 시점에 주입되므로 값을 바꾸면 재빌드(재배포)가 필요하다.
NEXT_PUBLIC_KAKAO_MAP_KEY=
