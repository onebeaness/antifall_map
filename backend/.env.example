# backend/.env 로 복사해서 사용 (키는 절대 프론트엔드/저장소에 노출 금지)

# 필수 — Tmap POI 검색·경로 탐색 (https://openapi.sk.com)
TMAP_APP_KEY=

# 선택 — 브라우저 배경지도(티맵 JS API v2)용 appKey.
# /api/config/map 으로 프론트에 내려간다. 비우면 위 TMAP_APP_KEY로 폴백한다.
# 지도 SDK 키는 브라우저에 노출되므로, openapi.sk.com에서 JS 지도 전용 앱을
# 따로 만들어 여기에 넣으면 REST 경로 API 할당량과 분리할 수 있다.
TMAP_JS_APP_KEY=

# 선택 — V-World 지오코딩 (POI 검색 실패 시 주소→좌표 보조).
# 배경지도는 프론트의 티맵 JS SDK가 담당한다.
VWORLD_API_KEY=

# 선택 — 기상청 API 허브 (https://apihub.kma.go.kr) — 없으면 Open-Meteo 폴백
KWEATHER_API_KEY=

# 선택 — SGIS 통계청 (https://sgis.kostat.go.kr/developer) — 인구밀도·고령화 지표
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 선택 — 서울 열린데이터광장 (https://data.seoul.go.kr) — 생활인구(유동인구, 서울 한정)
SEOUL_OPENAPI_KEY=

# 선택 — 공공데이터포털 (https://www.data.go.kr) — 전국보안등정보표준데이터 활용신청 후 인증키
DATA_GO_KR_KEY=

# CORS 허용 오리진 (쉼표 구분) — 배포 시 프론트 도메인으로 교체
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 모델 pkl 디렉토리 재지정 (기본: backend/models)
# MODELS_DIR=
