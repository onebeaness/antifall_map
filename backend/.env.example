# backend/.env 로 복사해서 사용 (키는 절대 프론트엔드/저장소에 노출 금지)

# 필수 — Tmap POI 검색·경로 탐색 (https://openapi.sk.com)
TMAP_APP_KEY=

# 선택 — V-World 배경지도 타일·지오코딩 (https://www.vworld.kr) — 없으면 OSM 폴백
VWORLD_API_KEY=
# V-World 인증키에 등록한 '사용URL'과 동일한 값 (타일 프록시가 Referer로 보냄)
# 예: https://antifall-map.pages.dev  — 비워두면 타일이 거부되어 OSM으로 폴백된다
VWORLD_REFERER=

# 선택 — 기상청 API 허브 (https://apihub.kma.go.kr) — 없으면 Open-Meteo 폴백
KWEATHER_API_KEY=

# 선택 — SGIS 통계청 (https://sgis.kostat.go.kr/developer) — 인구밀도·고령화 지표
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 선택 — 서울 열린데이터광장 (https://data.seoul.go.kr) — 생활인구(유동인구, 서울 한정)
SEOUL_OPENAPI_KEY=

# 선택 — 공공데이터포털 (https://www.data.go.kr) — 전국보안등정보표준데이터 활용신청 후 인증키
DATA_GO_KR_KEY=

# CORS 허용 오리진 (쉼표 구분) — 배포 시 프론트 도메인으로 교체
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 모델 pkl 디렉토리 재지정 (기본: backend/models)
# MODELS_DIR=
