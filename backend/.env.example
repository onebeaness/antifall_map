# backend/.env 로 복사해서 사용 (키는 절대 프론트엔드/저장소에 노출 금지)

# 필수 — Tmap POI 검색·경로 탐색 (https://openapi.sk.com)
TMAP_APP_KEY=

# 선택 — V-World 배경지도 타일·지오코딩 (https://www.vworld.kr) — 없으면 OSM 폴백
VWORLD_API_KEY=

# 선택 — 기상청 API 허브 (https://apihub.kma.go.kr) — 없으면 Open-Meteo 폴백
KWEATHER_API_KEY=

# CORS 허용 오리진 (쉼표 구분) — 배포 시 프론트 도메인으로 교체
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 모델 pkl 디렉토리 재지정 (기본: backend/models)
# MODELS_DIR=
